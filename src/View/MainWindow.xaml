<Window x:Name="Contact" x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View" xmlns:viewmodel="clr-namespace:View.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MainVM}"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="560" Icon="/contact_96x96.png">
    <Grid Margin="15" ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="0.15*"></RowDefinition>
        </Grid.RowDefinitions>
        <!--Left GroupBox: Запись данных контакта-->
        <GroupBox Grid.Row="0" Header="Edit contact" MinWidth="255" Grid.Column="0" Padding="3" HorizontalAlignment="Center" Margin="3">
            <StackPanel Orientation="Vertical">
                <Label>Name:</Label>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <Label>PhoneNumber:</Label>
                <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <Label>Email:</Label>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </StackPanel>
        </GroupBox>
        <!--Right GroupBox: Чтение данных контакта-->
        <GroupBox Grid.Row="0" Header="Read Conact" MinWidth="255" Grid.Column="1" Padding="3" HorizontalAlignment="Center" Margin="3">
            <StackPanel Orientation="Vertical">
                <Label>Name:</Label>
                <TextBlock Text="{Binding Name}" FontWeight="Bold"></TextBlock>

                <Label>PhoneNumber:</Label>
                <TextBlock Text="{Binding PhoneNumber}" FontWeight="Bold"></TextBlock>

                <Label>Email:</Label>
                <TextBlock Text="{Binding Email}" FontWeight="Bold"></TextBlock>
            </StackPanel>
        </GroupBox>
        <!--Bottom StackPanel: Блок с кнопками-->
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Margin="3" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button Command="{Binding SaveCommand}" CommandParameter="{Binding Contact}" Content="Save" Margin="3" Width="75px" Height="25px"></Button>
            <Button Command="{Binding LoadCommand}" Content="Load" Margin="3" Width="75px" Height="25px"></Button>
        </StackPanel>
    </Grid>
</Window>
