<Window x:Name="Contact" x:Class="View.MainWindow"
        xmlns:uc="clr-namespace:View.Controls"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:View" xmlns:viewmodel="clr-namespace:View.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:MainVM}"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800" Icon="/Recources/ContactsApp_96x96.ico">
    <Window.Resources>
        <DataTemplate x:Key="contactTemplate">
            <Grid Height="50px">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.2*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <Image Source="/Recources/photo_placeholder_100x100.png" Grid.RowSpan="2" Grid.Column="0" Grid.Row="0" Margin="0 2px 5px 2px"></Image>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom"></TextBlock>
                <TextBlock FontSize="12" Text="{Binding PhoneNumber}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top"></TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="15" ShowGridLines="True" Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.33*"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="0.66*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <GridSplitter Grid.Column="1" ShowsPreview="False" Width="3"
        HorizontalAlignment="Center" VerticalAlignment="Stretch" />

        <!-- Left StackPanel: Contact list and controls -->
        <StackPanel Grid.Column="0" Background="#F5F5F5">
            <Grid Margin="10px">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5*"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                
                <!-- Search pad -->
                <TextBlock Grid.Column="0" Grid.Row="0">Find:</TextBlock>
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0"></TextBox>

                <!-- Contacts list -->
                <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0 10 0 10" MinHeight="450px" ItemsSource="{Binding Contacts}" ItemTemplate="{StaticResource contactTemplate}" SelectionMode="Single">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding ListBox_SelectionChangedCommand}" PassEventArgsToCommand="True"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>

                <!-- Buttons -->
                <Button Grid.Row="2" Grid.Column="0" Padding="5" Margin="0 5 5 0" Command="{Binding AddCommand}">Add</Button>
                <Button Grid.Row="2" Grid.Column="1" Padding="5" Margin="0 5 5 0" IsEnabled="{Binding IsEditButtonEnabled}" Command="{Binding EditCommand}">Edit</Button>
                <Button Grid.Row="2" Grid.Column="2" Padding="5" Margin="0 5 0 0" IsEnabled="{Binding IsRemoveButtonEnabled}" Command="{Binding RemoveCommand}">Remove</Button>
            </Grid>
        </StackPanel>

        <!-- Right StackPanel: Contact info and editor -->
        <StackPanel Grid.Column="2">
            <uc:ContactControl IsEnabled="{Binding IsContactControlEnabled}"></uc:ContactControl>
            
            <!-- Apply Button -->
            <Button HorizontalAlignment="Left" Margin="170 50 0 0" Width="100" IsEnabled="{Binding IsApplyButtonEnabled}" Command="{Binding ApplyCommand}">Apply</Button>
        </StackPanel>
    </Grid>
</Window>
